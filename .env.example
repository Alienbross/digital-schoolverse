# Digital SchoolVerse - live pilot
# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Do NOT commit .env.local. No real keys are shipped in this repo.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional - live AI for the AI Teacher Assistant, AI Parent Helper and
# AI Study Tutor. Create a key at https://platform.openai.com/api-keys
# (or use any OpenAI-compatible provider and set OPENAI_BASE_URL below).
# Without this key the assistants keep using their clearly labelled demo
# drafts - nothing changes. Add it in Vercel: Project Settings ->
# Environment Variables -> OPENAI_API_KEY, then redeploy.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional - live email via Resend (free tier) for absence notices,
# invite emails, sickbay alerts and the teacher digest. Create a free
# account at https://resend.com, then an API key at
# https://resend.com/api-keys (Dashboard -> API Keys -> Create API Key).
# Without this key everything stays in-portal only - nothing changes.
# Add it in Vercel: Project Settings -> Environment Variables ->
# RESEND_API_KEY, then redeploy.
RESEND_API_KEY=
# Optional sender address. Without it the free-tier default
# onboarding@resend.dev is used - on the free tier Resend only
# delivers to the email address on the Resend account itself. To email
# real parents, teachers and invitees, verify a domain in Resend
# (Domains -> Add Domain) and set RESEND_FROM to an address on it,
# e.g. hello@digitalschoolverse.com.
# RESEND_FROM=onboarding@resend.dev
